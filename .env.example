# Copy to .env (never commit .env) and fill in.
# Client IDs are public identifiers, not secrets - but keep .env out of git anyway.

# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Your institute's Google Workspace domain
VITE_ALLOWED_DOMAIN=institution.edu.in

# Faculty emails (comma-separated). Every other signed-in account is a Student.
VITE_PROFESSOR_EMAILS=prof.one@institution.edu.in,prof.two@institution.edu.in
